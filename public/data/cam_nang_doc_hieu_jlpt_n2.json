{
  "document_title": "Cẩm nang Phương pháp Đọc hiểu JLPT N2 - Tài liệu học sinh MIO",
  "core_mindset": [
    {
      "title": "Nhận diện thói quen đọc (癖 - くせ)",
      "description": "Người làm đọc hiểu chưa tốt thường có thói quen đọc lệch hoặc dịch từng chữ. Muốn đạt điểm cao, cần biết điểm yếu của bản thân để điều chỉnh cách đọc cân bằng hơn."
    },
    {
      "title": "Đọc có mục đích",
      "description": "Đọc hiểu trong kỳ thi JLPT không phải để 'cảm thụ tự do', mà là tìm ra cách hiểu khớp với người ra đề. Gợi ý cho điều đó nằm ngay ở câu hỏi (設問 - せつもん)."
    },
    {
      "title": "Phân biệt 2 chế độ luyện tập",
      "modes": {
        "練習 (Luyện tập)": "Áp dụng khi ôn bài ở nhà để rèn tư duy và phản xạ nhận diện cấu trúc.",
        "本番 (Thi thật)": "Áp dụng trong phòng thi — thao tác gọn, ưu tiên tốc độ, không sa đà gạch chân hay vẽ sơ đồ rườm rà."
      }
    }
  ],
  "reading_stages": [
    {
      "stage_id": "Stage_1",
      "name": "Giai đoạn 1: Trước khi đọc (読む前の工夫)",
      "duration": "15-20 giây",
      "steps": [
        {
          "step": "2-1",
          "title": "Nhìn tiêu đề, đoán nội dung (タイトルを見て予測する)",
          "modes": [
            "練習",
            "本番"
          ],
          "details": [
            "Nhìn tiêu đề để dự đoán chủ đề (話題 - わだい) và quan điểm lập trường của tác giả (筆者の主張 - ひっしゃのしゅちょう).",
            "Khi đọc vào bài, chỉ cần kiểm chứng xem dự đoán của mình đúng hay sai giúp nắm ý chính nhanh hơn gấp đôi."
          ]
        },
        {
          "step": "2-2",
          "title": "Lướt nhanh tìm từ lặp lại (ざっと見て、多く出てくる言葉を見つける)",
          "modes": [
            "練習",
            "本番"
          ],
          "details": [
            "Dành 10-15 giây đảo mắt toàn bài để tìm những từ xuất hiện nhiều lần.",
            "Đó chính là từ khóa (キーワード) trung tâm của bài. Có thể ghi chú nhanh từ khóa ra lề."
          ]
        },
        {
          "step": "2-3",
          "title": "Đọc câu hỏi để lập kế hoạch (設問を見て、読み方を計画する)",
          "modes": [
            "練習",
            "本番"
          ],
          "details": [
            "Đọc trước câu hỏi để biết đề đang hỏi gì (ví dụ: Tác giả muốn nói điều gì nhất?, Từ gạch chân chỉ điều gì?, Điều nào đúng với nội dung bài?).",
            "Nhờ vậy, khi đọc bài bạn sẽ biết mình cần tập trung 'săn' thông tin ở đâu."
          ]
        }
      ]
    },
    {
      "stage_id": "Stage_2A",
