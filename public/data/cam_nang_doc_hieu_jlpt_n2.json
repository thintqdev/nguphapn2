          ]
        },
        {
          "step": "3-2",
          "title": "Phân biệt ý chính và ví dụ minh họa (大事か大事でないかを見極める)",
          "modes": [
            "練習",
            "本番"
          ],
          "details": [
            "Các đoạn ví dụ (thường mở đầu bằng たとえば) chỉ nhằm giải thích rõ hơn cho ý chính.",
            "Mẹo thực chiến: Nếu đọc câu chủ đề mà bạn đã hiểu ý rồi, hãy dùng ngoặc [] khoanh vùng đoạn ví dụ và đọc lướt qua. Khi làm câu hỏi, nếu đề hỏi chi tiết nào thì quay lại đúng phần trong ngoặc để đối chiếu."
          ]
        },
        {
          "step": "3-3",
          "title": "Tóm tắt bằng bảng hoặc sơ đồ tư duy (表・マップ・フローチャートにまとめる)",
          "modes": [
            "練習"
          ],
          "details": [
            "Khi luyện tập ở nhà với bài dài, hãy thử vẽ sơ đồ nhánh hoặc chia cột (ví dụ: Sự thật khách quan vs Suy đoán/Chủ trương của tác giả) để nhìn rõ cấu trúc bài. (Chỉ áp dụng khi luyện tập, không vẽ trong phòng thi)."
          ]
        }
      ]
