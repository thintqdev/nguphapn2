            {
              "group": "Đối lập / Bẻ lái",
              "signals": [
                "しかし",
                "だが",
                "ところが",
                "にもかかわらず",
                "一方(いっぽう)",
                "他方(たほう)",
                "反面(はんめん)",
                "cặp từ trái nghĩa (有料・無料...)"
