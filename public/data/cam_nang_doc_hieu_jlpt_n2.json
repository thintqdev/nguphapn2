    {
      "stage_id": "Stage_2B",
      "name": "Giai đoạn 2B: Trong khi đọc – Đọc nhanh (速く読む)",
      "steps": [
        {
          "step": "4-1",
          "title": "Đoán nghĩa từ mới qua ngữ cảnh (わからない表現の意味を推測する)",
          "modes": [
            "練習",
            "本番"
          ],
          "clues": [
            "Sắc thái của từ (語のイメージ): Xem từ đó mang màu sắc tích cực (như 勝利, 活躍) hay tiêu cực (như 害, 低下).",
            "Cấu tạo chữ Hán / Tiền tố – Hậu tố: Nhìn các thành phần quen thuộc như 無〜・反〜・非〜・不〜 (phủ định/không), 〜化 (hóa), 〜っぽい (có vẻ/hay)...",
            "Ngữ cảnh xung quanh: Tìm từ đồng nghĩa, trái nghĩa hoặc lời giải thích ngay câu trước/sau."
          ]
        },
        {
          "step": "4-2",
          "title": "Dự đoán diễn biến đoạn tiếp theo (次に読む部分の展開を予測する)",
          "modes": [
            "練習",
            "本番"
          ],
          "details": [
            "Dựa vào các cụm mở đầu vấn đề như 〜について・〜に関して・〜といえば・いったい・はたして hoặc các liên từ nối để đoán trước xem đoạn tiếp theo tác giả sẽ giải thích, phản biện hay đưa ra giải pháp, sau đó đọc tiếp để kiểm chứng."
          ]
        }
      ]
    },
    {
      "stage_id": "Stage_3",
